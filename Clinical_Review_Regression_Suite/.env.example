APP_URL=https://llm-rag-testing-workshop.streamlit.app/Application
DATASET_PATH=data/clinical_review_golden_dataset.csv
KNOWLEDGE_BASE_PATH=data/clinical_review_knowledge_base.md
RESULTS_DIR=results
HEADLESS=true
QUESTION_TIMEOUT_SECONDS=90
PAGE_LOAD_TIMEOUT_SECONDS=120
MAX_RETRIES=2
RELEVANCE_THRESHOLD=0.80
FAITHFULNESS_THRESHOLD=0.85
PRECISION_THRESHOLD=0.80
MAX_REGRESSION_DROP=0.05
EVALUATION_MODE=lexical
OPENAI_MODEL=gpt-5.4-mini
# Keep secrets local. Never commit this file after adding the key.
# OPENAI_API_KEY=your-rotated-project-key
